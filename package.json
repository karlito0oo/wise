{
  "name": "wise-full-stack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-assets.js",
    "prebuild": "node scripts/prepare-assets.js && node scripts/admin-create.js --username admin --password MyVerySecurePassword123!",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test",
    "admin:create": "node scripts/create-admin.js",
    "content:export": "node scripts/export-content.js",
    "check": "eslint src server shared tests scripts vite.config.js tailwind.config.js postcss.config.js"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "better-sqlite3": "^13.0.3",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.4"
  }
}
