# Generated by GitHub Copilot - Oct-10-2026
PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:3001
# Number of reverse proxies in front of Express (0 locally; 1 on hosts like Hostinger).
TRUST_PROXY=0

# Persistent data directory holding wise.sqlite and uploads/. Relative paths resolve
# from the project root. In production, point this at a persistent disk/volume OUTSIDE
# the deployed code directory (e.g. /var/data/wise), or every deploy starts empty.
DATA_DIR=server/data
# Optional per-item overrides; default to DATA_DIR/wise.sqlite and DATA_DIR/uploads.
# SQLITE_PATH=
# UPLOAD_DIR=
# Set NODE_ENV=production only behind HTTPS; admin cookies will then require HTTPS.

# First administrator, created only when the database has no administrators.
# Without ADMIN_PASSWORD a random password is generated and printed once at startup.
# Manage administrators afterwards in /admin > Administrators.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Contact email is disabled until SMTP_HOST, SMTP_FROM, and CONTACT_TO are set.
# Port 587 uses required STARTTLS; port 465 uses SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=wastointegrated.info@gmail.com